// ============================================================================
// TSHWANE CITY COLLEGE — STUDENT & PARENT PORTAL
// Prisma schema — PostgreSQL
//
// This file is the single source of truth for the relational database.
// Run `npx prisma migrate dev --name init` after configuring DATABASE_URL
// in .env to create the database and generate the client.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum RoleName {
  SUPER_ADMIN
  MANAGEMENT
  ACADEMIC_ADMIN
  LECTURER
  FINANCE
  STUDENT
  PARENT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
}

enum EnrolmentStatus {
  ACTIVE
  COMPLETED
  SUSPENDED
  WITHDRAWN
  DEFERRED
}

enum ResultStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  UNDER_VERIFICATION
  CONFIRMED
  REJECTED
  PARTIALLY_PAID
  PAID_IN_FULL
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  SUPERSEDED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum AnnouncementAudience {
  STUDENT
  PARENT
  CLASS
  PROGRAMME
  DEPARTMENT
  CAMPUS
  COLLEGE_WIDE
}

// ----------------------------------------------------------------------------
// IDENTITY, ROLES & PERMISSIONS
// ----------------------------------------------------------------------------

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // e.g. "results.publish", "fees.verify"
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                  String        @id @default(uuid())
  email               String        @unique
  phone               String?
  passwordHash        String
  roleId              String
  role                Role          @relation(fields: [roleId], references: [id])
  status              AccountStatus @default(PENDING_VERIFICATION)
  mustChangePassword  Boolean       @default(true)
  twoFactorEnabled    Boolean       @default(false)
  twoFactorSecret     String?
  failedLoginAttempts Int           @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  campusId            String?
  campus              Campus?       @relation(fields: [campusId], references: [id])

  student       Student?
  parent        ParentGuardian?
  staffProfile  Staff?

  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  sentMessages     Message[]           @relation("MessageSender")
  notifications    Notification[]
  announcementsMade Announcement[]    @relation("AnnouncementAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([campusId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ----------------------------------------------------------------------------
// INSTITUTION STRUCTURE
// ----------------------------------------------------------------------------

model Campus {
  id        String       @id @default(uuid())
  name      String       @unique
  address   String?
  users     User[]
  students  Student[]
  classes   Class[]
  createdAt DateTime     @default(now())
}

model Department {
  id         String      @id @default(uuid())
  name       String      @unique
  campusId   String?
  programmes Programme[]
  staff      Staff[]
  createdAt  DateTime    @default(now())
}

model Programme {
  id           String      @id @default(uuid())
  name         String
  code         String      @unique
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  durationYears Int        @default(1)
  subjects     Subject[]
  students     Student[]
  classes      Class[]
  createdAt    DateTime    @default(now())
}

model Subject {
  id          String    @id @default(uuid())
  name        String
  code        String    @unique
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])
  credits     Int       @default(0)
  enrolments  Enrolment[]
  results     Result[]
  materials   LearningMaterial[]
  createdAt   DateTime  @default(now())
}

model Class {
  id           String     @id @default(uuid())
  name         String
  programmeId  String
  programme    Programme  @relation(fields: [programmeId], references: [id])
  campusId     String
  campus       Campus     @relation(fields: [campusId], references: [id])
  academicYear String
  semester     Int
  lecturerId   String?
  lecturer     Staff?     @relation(fields: [lecturerId], references: [id])
  students     Student[]
  attendance   Attendance[]
  timetables   Timetable[]
  createdAt    DateTime   @default(now())
}

// ----------------------------------------------------------------------------
// PEOPLE
// ----------------------------------------------------------------------------

model Student {
  id             String          @id @default(uuid())
  studentNumber  String          @unique
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id])
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  idNumber       String?         @unique
  address        String?
  programmeId    String?
  programme      Programme?      @relation(fields: [programmeId], references: [id])
  campusId       String?
  campus         Campus?         @relation(fields: [campusId], references: [id])
  classId        String?
  class          Class?          @relation(fields: [classId], references: [id])
  enrolmentStatus EnrolmentStatus @default(ACTIVE)

  parentLinks    StudentParentLink[]
  enrolments     Enrolment[]
  results        Result[]
  attendance     Attendance[]
  fees           Fee[]
  documents      Document[]
  submissions    AssignmentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programmeId])
  @@index([classId])
}

model ParentGuardian {
  id        String              @id @default(uuid())
  userId    String              @unique
  user      User                @relation(fields: [userId], references: [id])
  firstName String
  lastName  String
  phone     String?
  students  StudentParentLink[]
  createdAt DateTime            @default(now())
}

// Explicit join table: a parent may be linked to more than one student,
// and a student may (rarely) have more than one linked guardian.
model StudentParentLink {
  studentId  String
  parentId   String
  relationship String  // e.g. "Mother", "Father", "Legal Guardian"
  isPrimary  Boolean  @default(false)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent     ParentGuardian @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
}

model Staff {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id])
  firstName    String
  lastName     String
  employeeNumber String    @unique
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  jobTitle     String?     // e.g. "Lecturer", "Registrar", "Finance Officer"
  classes      Class[]
  createdAt    DateTime    @default(now())
}

// ----------------------------------------------------------------------------
// ACADEMICS: ENROLMENT, RESULTS, ATTENDANCE, EXAMS, MATERIALS
// ----------------------------------------------------------------------------

model Enrolment {
  id           String          @id @default(uuid())
  studentId    String
  student      Student         @relation(fields: [studentId], references: [id])
  subjectId    String
  subject      Subject         @relation(fields: [subjectId], references: [id])
  academicYear String
  semester     Int
  status       EnrolmentStatus @default(ACTIVE)
  createdAt    DateTime        @default(now())

  @@unique([studentId, subjectId, academicYear, semester])
}

model Examination {
  id           String   @id @default(uuid())
  name         String   // e.g. "End of Semester Exam"
  subjectId    String
  academicYear String
  semester     Int
  examDate     DateTime?
  maxMarks     Int      @default(100)
  results      Result[]
  timetables   Timetable[]
  createdAt    DateTime @default(now())
}

model Result {
  id            String       @id @default(uuid())
  studentId     String
  student       Student      @relation(fields: [studentId], references: [id])
  subjectId     String
  subject       Subject      @relation(fields: [subjectId], references: [id])
  examinationId String?
  examination   Examination? @relation(fields: [examinationId], references: [id])
  marksObtained Decimal      @db.Decimal(6, 2)
  maxMarks      Decimal      @db.Decimal(6, 2) @default(100)
  percentage    Decimal      @db.Decimal(5, 2)
  grade         String?
  passed        Boolean?
  status        ResultStatus @default(DRAFT)
  publishedAt   DateTime?
  enteredById   String
  history       ResultHistory[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([studentId])
  @@index([subjectId])
  @@index([status])
}

// Immutable append-only audit trail for every change to a Result.
model ResultHistory {
  id            String   @id @default(uuid())
  resultId      String
  result        Result   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  changedById   String
  previousValue Json
  newValue      Json
  reason        String
  changedAt     DateTime @default(now())

  @@index([resultId])
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  classId   String
  class     Class            @relation(fields: [classId], references: [id])
  date      DateTime         @db.Date
  status    AttendanceStatus
  comment   String?
  recordedById String
  createdAt DateTime         @default(now())

  @@unique([studentId, classId, date])
  @@index([classId, date])
}

model LearningMaterial {
  id         String   @id @default(uuid())
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id])
  title      String
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])
  uploadedById String
  createdAt  DateTime @default(now())
}

model Assignment {
  id          String   @id @default(uuid())
  subjectId   String
  title       String
  description String?
  dueDate     DateTime
  maxMarks    Decimal  @db.Decimal(6, 2) @default(100)
  submissions AssignmentSubmission[]
  createdAt   DateTime @default(now())
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  documentId   String?
  document     Document?  @relation(fields: [documentId], references: [id])
  submittedAt  DateTime   @default(now())
  markAwarded  Decimal?   @db.Decimal(6, 2)

  @@unique([assignmentId, studentId])
}

// ----------------------------------------------------------------------------
// FINANCE
// ----------------------------------------------------------------------------

model Fee {
  id               String        @id @default(uuid())
  studentId        String
  student          Student       @relation(fields: [studentId], references: [id])
  academicYear     String
  description      String        // e.g. "Tuition Semester 1"
  amountDue        Decimal       @db.Decimal(10, 2)
  amountPaid       Decimal       @db.Decimal(10, 2) @default(0)
  dueDate          DateTime?
  status           PaymentStatus @default(PENDING)
  payments         Payment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([studentId])
  @@index([status])
}

model Payment {
  id              String        @id @default(uuid())
  feeId           String
  fee             Fee           @relation(fields: [feeId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  method          String?       // e.g. "EFT", "Cash", "Card"
  referenceNumber String?
  status          PaymentStatus @default(SUBMITTED)
  proof           PaymentProof?
  receipt         Receipt?
  verifiedById    String?
  verifiedAt      DateTime?
  submittedAt     DateTime      @default(now())

  @@index([feeId])
  @@index([status])
}

model PaymentProof {
  id         String   @id @default(uuid())
  paymentId  String   @unique
  payment    Payment  @relation(fields: [paymentId], references: [id])
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  uploadedById String
  uploadedAt DateTime @default(now())
}

model Receipt {
  id            String   @id @default(uuid())
  paymentId     String   @unique
  payment       Payment  @relation(fields: [paymentId], references: [id])
  receiptNumber String   @unique
  documentId    String?
  document      Document? @relation(fields: [documentId], references: [id])
  issuedAt      DateTime @default(now())
}

model Statement {
  id         String   @id @default(uuid())
  studentId  String
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])
  periodFrom DateTime
  periodTo   DateTime
  generatedAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// DOCUMENTS
// ----------------------------------------------------------------------------

model Document {
  id            String         @id @default(uuid())
  type          String         // e.g. "TRANSCRIPT", "ADMISSION_LETTER", "PROOF_OF_PAYMENT"
  fileName      String
  storageKey    String         // path/key in the object storage bucket
  mimeType      String
  sizeBytes     Int
  version       Int            @default(1)
  status        DocumentStatus @default(ACTIVE)
  studentId     String?
  student       Student?       @relation(fields: [studentId], references: [id])
  uploadedById  String
  uploadedAt    DateTime       @default(now())

  paymentProofs PaymentProof[]
  receipts      Receipt[]
  statements    Statement[]
  materials     LearningMaterial[]
  submissions   AssignmentSubmission[]

  @@index([studentId])
  @@index([type])
}

// ----------------------------------------------------------------------------
// COMMUNICATION
// ----------------------------------------------------------------------------

model Announcement {
  id         String               @id @default(uuid())
  title      String
  body       String
  audience   AnnouncementAudience
  targetId   String?              // classId / programmeId / departmentId / campusId, per audience
  createdById String
  createdBy  User                 @relation("AnnouncementAuthor", fields: [createdById], references: [id])
  publishedAt DateTime            @default(now())
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  recipientId String
  subject    String?
  body       String
  readAt     DateTime?
  sentAt     DateTime @default(now())

  @@index([recipientId])
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  channel   NotificationChannel
  title     String
  body      String
  readAt    DateTime?
  sentAt    DateTime            @default(now())

  @@index([userId, readAt])
}

// ----------------------------------------------------------------------------
// TIMETABLES
// ----------------------------------------------------------------------------

model Timetable {
  id            String       @id @default(uuid())
  classId       String?
  class         Class?       @relation(fields: [classId], references: [id])
  examinationId String?
  examination   Examination? @relation(fields: [examinationId], references: [id])
  dayOfWeek     Int?         // 1=Monday ... 7=Sunday, null for exam timetables
  startTime     String       // "08:00"
  endTime       String       // "09:30"
  room          String?
  createdAt     DateTime     @default(now())
}

// ----------------------------------------------------------------------------
// SECURITY & AUDIT
// ----------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // e.g. "LOGIN_SUCCESS", "RESULT_UPDATED", "PAYMENT_VERIFIED"
  entityType String?  // e.g. "Result", "Payment"
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
